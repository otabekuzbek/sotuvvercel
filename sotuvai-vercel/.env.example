# ===== Asosiy =====
APP_NAME=SotuvAI
# Uzun tasodifiy satr kiriting (masalan: openssl rand -hex 32)
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Ilova ochiladigan manzil (amoCRM shu manzilga qaytaradi), https bo'lishi shart.
# Vercel'da bo'sh qoldirsangiz loyiha domeni (*.vercel.app) avtomatik olinadi.
PUBLIC_URL=
TIMEZONE=Asia/Tashkent
# Kalitlarsiz ko'rib chiqish uchun demo ma'lumot (ishlab chiqarishda false)
DEMO_MODE=false

# ===== Ma'lumotlar bazasi =====
# Bo'sh bo'lsa SQLite (faqat Docker/serverda). Vercel'da Postgres SHART (Neon: Vercel > Storage).
# Vercel Neon'ni ulasa DATABASE_URL o'zi qo'shiladi.
DATABASE_URL=

# ===== Cron (Vercel) =====
# /api/cron/* ni himoyalaydi. Uzun tasodifiy satr (openssl rand -hex 24)
CRON_SECRET=

# ===== amoCRM =====
# mycompany.amocrm.ru bo'lsa -> mycompany
AMO_SUBDOMAIN=
AMO_BASE_DOMAIN=amocrm.ru
# 1-variant: integratsiya (OAuth) — amoCRM > Sozlamalar > Integratsiyalar > Integratsiya yaratish
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
# Redirect URI amoCRM'da: {PUBLIC_URL}/oauth/amocrm/callback
# 2-variant: uzoq muddatli token (OAuth o'rniga, shaxsiy integratsiya uchun eng oson)
AMO_LONG_LIVED_TOKEN=
AMO_CREATE_TASKS=true
AMO_ADD_NOTES=true

# ===== Google Speech-to-Text =====
# console.cloud.google.com > Speech-to-Text API ni yoqing > Credentials > API key
GOOGLE_API_KEY=
STT_LANGUAGE=uz-UZ
STT_ALT_LANGUAGES=ru-RU
STT_SPLIT_CHANNELS=true

# ===== Claude =====
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== Telegram =====
# @BotFather dan token; chat ID — botni guruhga qo'shib, guruh ID sini kiriting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_TIME=19:00
LOW_SCORE_ALERT=50

# ===== Ish jarayoni =====
SYNC_INTERVAL_MIN=5
MIN_CALL_SECONDS=30
PROCESS_BATCH=10
# Bitta cron chaqiruvida ishlash vaqti, soniya (Vercel Hobby: 300 s dan oshmasin)
PROCESS_TIME_BUDGET=230
COACHING_THRESHOLD=65
